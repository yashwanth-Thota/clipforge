# ---------------------------------------------------------------------------
# ClipForge environment. Copy to .env and fill in. Everything defaults to a
# zero-cost local setup so the app runs with no keys.
# ---------------------------------------------------------------------------

# --- Database (libSQL / SQLite). Local file by default; Turso free tier for prod.
DATABASE_URL="file:./local.db"
# DATABASE_AUTH_TOKEN=""   # only for Turso/remote libSQL

# --- Storage driver: local | r2 | supabase
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="./uploads"
# R2 (Cloudflare) — free egress
# R2_ACCOUNT_ID=""
# R2_ACCESS_KEY_ID=""
# R2_SECRET_ACCESS_KEY=""
# R2_BUCKET=""
# Supabase Storage
# SUPABASE_URL=""
# SUPABASE_SERVICE_ROLE_KEY=""
# SUPABASE_BUCKET="clipforge"

# ---------------------------------------------------------------------------
# Pluggable AI providers. Pick a provider per capability; each is swappable and
# self-configurable (bring your own endpoint/key). Defaults are zero-cost.
# ---------------------------------------------------------------------------

# Transcription (auto-captioning): groq | local | browser | huggingface
TRANSCRIPTION_PROVIDER="local"
GROQ_API_KEY=""                      # Groq offers a free tier for whisper-large-v3
HUGGINGFACE_API_KEY=""
WHISPER_MODEL="whisper-large-v3"

# Translation (caption translation): libretranslate | huggingface | none
TRANSLATION_PROVIDER="libretranslate"
LIBRETRANSLATE_URL="https://libretranslate.com"
LIBRETRANSLATE_API_KEY=""            # self-host for unlimited/free
TRANSLATION_TARGET_LANGS="es,hi,pt,fr,de"

# Categorization (group videos by topic): keyword | embedding | llm
CATEGORIZATION_PROVIDER="keyword"
# For llm/embedding you can point at any OpenAI-compatible endpoint (Ollama, Groq, etc.)
LLM_BASE_URL="http://localhost:11434/v1"
LLM_API_KEY=""
LLM_MODEL="llama3.1:8b"

# Copyright-free music: local | jamendo | pixabay
MUSIC_PROVIDER="local"
JAMENDO_CLIENT_ID=""                 # free API key from Jamendo
PIXABAY_API_KEY=""

# Viral-moment scoring: heuristic | llm
VIRAL_PROVIDER="heuristic"

# ---------------------------------------------------------------------------
# Feature flags (extensibility + legal/ToS guardrails)
# ---------------------------------------------------------------------------
FEATURE_YOUTUBE_IMPORT="true"        # import metadata from YouTube URLs/channels
FEATURE_YOUTUBE_DOWNLOAD="false"     # download source media (review YouTube ToS first)
FEATURE_AUTOPOST="false"             # requires per-platform API approval
FEATURE_MONETIZATION="false"         # billing/credits (Phase 6)
